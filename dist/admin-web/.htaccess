<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Security & Cache-Control Headers
<IfModule mod_headers.c>
  # 1. Cache fingerprinted/hashed static assets aggressively (1 year immutable)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|webp)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # 2. Never cache entry-point HTML so browsers immediately fetch new deployments
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
