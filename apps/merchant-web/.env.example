# ====================================================================
# TAPAUTIME PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ====================================================================
# Copy this file to .env or .env.production in the relevant app directories.
# Variables prefixed with VITE_ are exposed to the client-side browser bundle.
# All other variables MUST remain strictly secret on the server or Edge Functions.
# ====================================================================

# --------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE
# --------------------------------------------------------------------
# Production Supabase Project URL (Client & Edge Functions)
VITE_SUPABASE_URL=https://iaqohdvdebgxtfbxijsw.supabase.co

# Production Supabase Anonymous / Public Key (Safe for browser clients)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlhcW9oZHZkZWJneHRmYnhpanN3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcwNzkyNjIsImV4cCI6MjEwMjY1NTI2Mn0.DFFY_o-wlxonj1mlHsHe3M9_ELGWtTmaqgc1iGr33WE

# Supabase Service Role Secret Key (STRICTLY PRIVATE - NEVER expose in client bundles!)
# Used only in Supabase CLI, DB Migrations, and Edge Function Secrets
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Direct PostgreSQL Connection URL (For schema migrations and admin maintenance)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.iaqohdvdebgxtfbxijsw.supabase.co:5432/postgres

# --------------------------------------------------------------------
# 2. EDGE FUNCTIONS & API ENDPOINTS
# --------------------------------------------------------------------
# Atomic Checkout Edge Function Endpoint
VITE_CHECKOUT_EDGE_FUNCTION_URL=https://iaqohdvdebgxtfbxijsw.supabase.co/functions/v1/checkout

# Payment Webhook Edge Function Endpoint (Stripe / ToyyibPay / Curlec)
SUPABASE_WEBHOOK_URL=https://iaqohdvdebgxtfbxijsw.supabase.co/functions/v1/payment-webhook

# --------------------------------------------------------------------
# 3. SUPABASE STORAGE BUCKETS
# --------------------------------------------------------------------
# Storage bucket name for DuitNow receipt image uploads (<200KB squashed)
VITE_STORAGE_RECEIPTS_BUCKET=payment_receipts

# Maximum allowed receipt upload size in bytes (200KB anti-bloat limit)
VITE_RECEIPT_MAX_SIZE_BYTES=204800

# --------------------------------------------------------------------
# 4. HOSTINGER PRODUCTION SUBDOMAIN MAPPINGS
# --------------------------------------------------------------------
# Customer Progressive Web App (Mobile-first, standalone PWA)
# Deployed to Hostinger subdomain: app.tapautime.my -> public_html/app
VITE_CUSTOMER_APP_URL=https://app.tapautime.my

# Merchant Kitchen Display System (KDS, anti-fraud receipt verifier)
# Deployed to Hostinger subdomain: kds.tapautime.my -> public_html/kds
VITE_MERCHANT_KDS_URL=https://kds.tapautime.my

# Marketing Landing Page & Table Ordering Portal
# Deployed to Hostinger root domain: tapautime.my -> public_html
VITE_LANDING_URL=https://tapautime.my

# --------------------------------------------------------------------
# 5. REGIONAL & OPERATIONAL SETTINGS
# --------------------------------------------------------------------
# Business operational timezone (UTC+8 for Malaysian Kopitiams)
VITE_DEFAULT_TIMEZONE=Asia/Kuching

# Merchant stall heartbeat ping interval in milliseconds (60 seconds)
VITE_HEARTBEAT_INTERVAL_MS=60000

# Merchant stall offline threshold (stalls inactive > 2 minutes are auto-offline)
VITE_HEARTBEAT_TIMEOUT_MS=120000

# Active application environment ('development' | 'staging' | 'production')
VITE_ENVIRONMENT=production
